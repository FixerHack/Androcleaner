<?xml version="1.0" encoding="utf-8"?>
<!-- "full" flavor: adds the accessibility service that presses "Clear cache" in Settings.
     Play Protect blocks browser-sideloaded apps declaring it, so it ships as a separate APK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name="app.androcleaner.feature.cache.CacheCleanerService"
            android:exported="false"
            android:label="@string/cache_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/cache_cleaner_service" />
        </service>
    </application>
</manifest>
