    <!-- Cache cleaning -->
    <string name="cache_service_label">Androcleaner cache cleaner</string>
    <string name="cache_service_summary">Presses \"Clear cache\" in Settings for you</string>
    <string name="cache_service_description">Androcleaner uses this only when you tap \"Clear cache\". It opens each app\'s info page in Settings and presses Storage → Clear cache for you. It doesn\'t read your screen, messages or other apps.</string>
    <string name="cache_overlay_title">Clearing cache</string>
    <string name="cache_overlay_counter">%1$d of %2$d</string>
    <string name="cache_overlay_stop">Stop</string>
    <string name="cache_cleaned">Cache cleared: %1$s freed</string>
    <string name="cache_clean_button">Clear</string>
    <string name="cache_clean_all">Clear cache of all apps · %1$s</string>
    <string name="cache_setup_title">Clear cache automatically</string>
    <string name="cache_setup_text">Android only lets an app clear other apps\' cache through Settings. Turn on \"Androcleaner cache cleaner\" in Accessibility and it will press \"Clear cache\" for every app by itself — you won\'t have to do anything.</string>
    <string name="cache_setup_restricted">If the switch is greyed out: Settings → Apps → Androcleaner → ⋮ → Allow restricted settings.</string>
    <string name="cache_setup_enable">Turn on</string>
    <string name="cache_setup_quick">Quick clean only</string>
    <string name="app_cache_auto_desc">Androcleaner presses \"Clear cache\" for each app for you.</string>
