    <!-- Очищення кешу -->
    <string name="cache_service_label">Очищення кешу Androcleaner</string>
    <string name="cache_service_summary">Натискає «Очистити кеш» у налаштуваннях замість вас</string>
    <string name="cache_service_description">Androcleaner використовує це лише коли ви натискаєте «Очистити кеш». Він відкриває сторінку кожної апки в налаштуваннях і сам натискає «Пам\'ять і кеш» → «Очистити кеш». Він не читає ваш екран, повідомлення чи інші апки.</string>
    <string name="cache_overlay_title">Очищаю кеш</string>
    <string name="cache_overlay_counter">%1$d з %2$d</string>
    <string name="cache_overlay_stop">Зупинити</string>
    <string name="cache_cleaned">Кеш очищено: звільнено %1$s</string>
    <string name="cache_clean_button">Очистити</string>
    <string name="cache_clean_all">Очистити кеш усіх апок · %1$s</string>
    <string name="cache_setup_title">Автоматичне очищення кешу</string>
    <string name="cache_setup_text">Android дозволяє чистити кеш інших апок лише через налаштування. Увімкніть «Очищення кешу Androcleaner» у Спеціальних можливостях — і він сам натисне «Очистити кеш» для кожної апки. Вам нічого не треба робити.</string>
    <string name="cache_setup_restricted">Якщо перемикач неактивний: Налаштування → Додатки → Androcleaner → ⋮ → Дозволити обмежені налаштування.</string>
    <string name="cache_setup_enable">Увімкнути</string>
    <string name="cache_setup_quick">Лише швидке очищення</string>
    <string name="app_cache_auto_desc">Androcleaner сам натисне «Очистити кеш» для кожної апки.</string>
    <string name="apps_total_size">Разом %1$s</string>
    <string name="note_apk_unreadable">Не вдалося прочитати пакет</string>

    <string name="apps_empty">Тут порожньо</string>
    <string name="apps_empty_desc">Увімкніть фільтр «Системні», щоб побачити передвстановлені апки.</string>

    <string name="cache_quick_title">Очищення кешу апок</string>
    <string name="cache_quick_text">Android покаже вікно для очищення кешу, який апки тримають у спільному сховищі — зазвичай це найбільша частина. Для повністю автоматичного очищення кожної апки встановіть Androcleaner Full (див. сторінку проєкту).</string>

